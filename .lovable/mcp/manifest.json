              "type": "string",
              "description": "Filtre optionnel sur le nom de la classe."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "rechercher_eleves",
