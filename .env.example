# =====================================================================
# Variables d'environnement — modèle (AUCUN SECRET ICI)
# =====================================================================
# Copiez ce fichier vers .env.local pour le développement local :
#   cp .env.example .env.local
# puis remplissez les valeurs avec la sortie de `supabase status`.
#
# .env.local est ignoré par Git (règle `*.local` du .gitignore) et a la
# priorité sur .env dans Vite : c'est le bon endroit pour pointer vers la
# stack Supabase locale sans toucher aux valeurs de production.
# =====================================================================

# URL de l'API Supabase.
#   - Local   : http://127.0.0.1:54321
#   - Distant : https://<project-ref>.supabase.co
VITE_SUPABASE_URL="http://127.0.0.1:54321"

# Clé publique (anon / publishable). Non secrète : elle est exposée au client
# et protégée par les politiques RLS. La valeur locale est fournie par
# `supabase status` et est identique sur toutes les installations locales.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Référence du projet Supabase distant.
#   - Local   : laisser "local" (aucun appel distant ne doit en dépendre)
#   - Distant : le project-ref, ex. abcdefghijklmnopqrst
VITE_SUPABASE_PROJECT_ID="local"
